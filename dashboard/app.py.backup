# ============================================================================
# DATABRICKS CONNECTION
# ============================================================================
@st.cache_resource
def get_databricks_connection():
    from dotenv import load_dotenv
    load_dotenv('.env.databricks')
    from databricks.sql import connect

    host = os.getenv('DATABRICKS_HOST').replace('https://', '')
    token = os.getenv('DATABRICKS_TOKEN')
    http_path = os.getenv('DATABRICKS_HTTP_PATH')

    return connect(
        server_hostname=host,
        http_path=http_path,
        personal_access_token=token
    )

# ============================================================================
# DATA LOADING FUNCTIONS
# ============================================================================
def get_bias_metrics(scenario=None, start_date=None, end_date=None):
    """Get bias metrics from gold layer"""
    try:
        conn = get_databricks_connection()
        cursor = conn.cursor()

        query = "SELECT * FROM healthcare_equity_gold.bias_metrics"
        if scenario:
            query += f" WHERE scenario_type = '{scenario}'"

        cursor.execute(query)
        results = cursor.fetchall()

        if results:
            cols = [desc[0] for desc in cursor.description]
            return pd.DataFrame(results, columns=cols)
        return pd.DataFrame()
    except Exception as e:
        st.error(f"Error loading bias metrics: {str(e)[:100]}")
        return pd.DataFrame()

def get_all_four_scenarios(start_date=None, end_date=None):
    """Get metrics for all 4 bias scenarios"""
    try:
        conn = get_databricks_connection()
        cursor = conn.cursor()

        scenarios_data = {}
        scenarios = [
            'cardiac_catheterization',
            'pain_management',
            'mental_health_referral',
            'hospital_admission'
        ]

        for scenario in scenarios:
            query = f"""
            SELECT
                scenario_type,
                race,
                gender,
                approval_rate,
                ROUND(approval_rate / MAX(approval_rate) OVER () * 100, 2) as dir_percentage,
                total_decisions,
                unique_patients,
                first_decision_date,
                last_decision_date
            FROM healthcare_equity_gold.bias_metrics
            WHERE scenario_type = '{scenario}'
            """
            if start_date and end_date:
                query += f" AND first_decision_date >= '{start_date}' AND last_decision_date <= '{end_date}'"

            cursor.execute(query)
            results = cursor.fetchall()

            if results:
                cols = [desc[0] for desc in cursor.description]
                scenarios_data[scenario] = pd.DataFrame(results, columns=cols)
            else:
                scenarios_data[scenario] = pd.DataFrame()

        return scenarios_data
    except Exception as e:
        st.error(f"Error loading scenarios: {str(e)[:100]}")
        return {}

def get_dashboard_summary():
    """Get dashboard summary metrics"""
    try:
        conn = get_databricks_connection()
        cursor = conn.cursor()

        query = "SELECT * FROM healthcare_equity_gold.equity_dashboard LIMIT 1"
        cursor.execute(query)
        result = cursor.fetchone()

        if result:
            cols = [desc[0] for desc in cursor.description]
            return dict(zip(cols, result))
        return {}
    except Exception as e:
        st.error(f"Error loading summary: {str(e)[:100]}")
        return {}


# ============================================================================
# SECTION 1: ALL 4 BIAS SCENARIOS
# ============================================================================
st.markdown("### 🏥 Bias Detection Across All 4 Clinical Scenarios")

# Pass date filters to data loading
scenarios_data = get_all_four_scenarios(
    start_date=start_date.isoformat() if start_date else None,
    end_date=end_date.isoformat() if end_date else None
)

# Create tabs for each scenario
scenario_tabs = st.tabs([
    "🫀 Cardiac Catheterization",
    "💊 Pain Management",
    "🧠 Mental Health",
    "🏥 Hospital Admission"
])

scenario_info = {
    'cardiac_catheterization': {
        'title': 'Cardiac Catheterization',
        'description': 'Black patients receive cardiac catheterization 40% less often (Schulman et al. NEJM 1999)',
        'color': '#E63946'
    },
    'pain_management': {
        'title': 'Pain Management',
        'description': 'Women receive opioid prescriptions 25% less frequently (Hoffmann & Tarzian 2001)',
        'color': '#F77F00'
    },
    'mental_health_referral': {
        'title': 'Mental Health Referral',
        'description': 'LGBTQ+ patients receive mental health referrals 30% less (Hatzenbuehler et al. 2009)',
        'color': '#006BA6'
    },
    'hospital_admission': {
        'title': 'Hospital Admission',
        'description': 'Low-SES patients admitted 35% less frequently (Galobardes et al. 2006)',
        'color': '#13A538'
    }
}

for idx, (tab, scenario) in enumerate(zip(scenario_tabs, all_scenarios)):
    with tab:
        if scenario in scenarios_data and not scenarios_data[scenario].empty:
            df = scenarios_data[scenario]
            info = scenario_info[scenario]

            # Scenario header
            st.markdown(f"""
            <div style='background-color: {info["color"]}15; padding: 15px; border-radius: 10px; border-left: 4px solid {info["color"]}; margin-bottom: 20px;'>
                <h4 style='color: {info["color"]}; margin: 0;'>{info['title']}</h4>
                <p style='color: #666; margin: 10px 0 0 0;'>{info['description']}</p>
            </div>
            """, unsafe_allow_html=True)

            # Metrics by race
            st.markdown("#### Statistics by Demographic")

            col_stat1, col_stat2, col_stat3 = st.columns(3)

            with col_stat1:
                avg_approval = df['approval_rate'].mean()
                st.metric(
                    "Average Approval Rate",
                    f"{avg_approval:.1f}%",
                    delta=f"Min: {df['approval_rate'].min():.1f}%"
                )

            with col_stat2:
                total_decisions = df['total_decisions'].sum()
                st.metric(
                    "Total Decisions",
                    f"{int(total_decisions):,}",
                    delta=f"Patients: {int(df['unique_patients'].sum()):,}"
                )

            with col_stat3:
                dir_range = df['approval_rate'].max() - df['approval_rate'].min()
                st.metric(
                    "Disparity Range",
                    f"{dir_range:.1f}%",
                    delta="Variation"
                )

            # Detailed table
            st.markdown("#### Breakdown by Demographics")

            # Select available columns
            available_cols = ['race', 'gender', 'approval_rate', 'total_decisions', 'unique_patients']
            existing_cols = [col for col in available_cols if col in df.columns]

            if existing_cols:
                display_df = df[existing_cols].copy()
                col_names = {
                    'race': 'Race',
                    'gender': 'Gender',
                    'approval_rate': 'Approval Rate (%)',
                    'total_decisions': 'Decisions',
                    'unique_patients': 'Patients'
                }
                display_df.columns = [col_names.get(col, col) for col in existing_cols]

                # Format percentage
                if 'Approval Rate (%)' in display_df.columns:
                    display_df['Approval Rate (%)'] = display_df['Approval Rate (%)'].apply(lambda x: f"{x:.2f}%")

                st.dataframe(display_df, use_container_width=True, hide_index=True)
            else:
                st.warning("No data available for this scenario")

            # Visualization
            st.markdown("#### Visual Analysis")

            col_chart1, col_chart2 = st.columns(2)

            with col_chart1:
                # Bar chart by race
                if 'race' in df.columns and 'approval_rate' in df.columns:
                    try:
                        chart_data = df.groupby('race')['approval_rate'].mean().reset_index()
                        fig = px.bar(
                            chart_data,
                            x='race',
                            y='approval_rate',
                            title=f'Approval Rate by Race - {info["title"]}',
                            color_discrete_sequence=[info['color']],
                            labels={'approval_rate': 'Approval Rate (%)', 'race': 'Race'},
                            height=350
                        )
                        fig.update_layout(
                            template='plotly_white',
                            showlegend=False,
                            hovermode='x unified'
                        )
                        st.plotly_chart(fig, use_container_width=True)
                    except Exception as e:
                        st.warning(f"Could not generate chart: {str(e)[:50]}")
                else:
                    st.info("Race data not available for this scenario")

            with col_chart2:
                # Distribution pie chart
                if 'race' in df.columns:
                    try:
                        dist_data = df.groupby('race').size().reset_index(name='count')
                        fig = px.pie(
                            dist_data,
                            names='race',
                            values='count',
                            title=f'Patient Distribution - {info["title"]}',
                            height=350,
                            color_discrete_sequence=px.colors.qualitative.Set3
                        )
                        fig.update_layout(template='plotly_white')
                        st.plotly_chart(fig, use_container_width=True)
                    except Exception as e:
                        st.warning(f"Could not generate distribution: {str(e)[:50]}")
                else:
                    st.info("Distribution data not available")
        else:
            st.info(f"📊 Loading {scenario} data...")

st.markdown("---")

# ============================================================================
# SECTION 2: PROVIDER ACCOUNTABILITY
# ============================================================================
st.markdown("### 👥 Provider Accountability & Equity Scores")

try:
    conn = get_databricks_connection()
    cursor = conn.cursor()

    query = """
    SELECT
        race,
        gender,
        age_group,
        approval_pct,
        readmission_rate,
        mortality_rate
    FROM healthcare_equity_gold.provider_accountability
    ORDER BY approval_pct DESC
    LIMIT 20
    """
    cursor.execute(query)
    results = cursor.fetchall()

    if results:
        cols = [desc[0] for desc in cursor.description]
        accountability_df = pd.DataFrame(results, columns=cols)

        col_acc1, col_acc2 = st.columns(2)

        with col_acc1:
            fig = px.scatter(
                accountability_df,
                x='readmission_rate',
                y='approval_pct',
                size='mortality_rate',
                color='gender',
                hover_data=['race', 'age_group'],
                title='Approval Rate vs Readmission Risk',
                labels={'approval_pct': 'Approval %', 'readmission_rate': 'Readmission Rate'},
                height=400
            )
            fig.update_layout(template='plotly_white')
            st.plotly_chart(fig, use_container_width=True)

        with col_acc2:
            st.markdown("#### Key Metrics")

            col_m1, col_m2, col_m3 = st.columns(3)

            with col_m1:
                st.metric(
                    "Avg Approval",
                    f"{accountability_df['approval_pct'].mean():.1f}%",
                    delta="By Demographics"
                )

            with col_m2:
                st.metric(
                    "Readmission Range",
                    f"{accountability_df['readmission_rate'].max():.3f}",
                    delta=f"Min: {accountability_df['readmission_rate'].min():.3f}"
                )

            with col_m3:
                st.metric(
                    "Mortality Rate",
                    f"{accountability_df['mortality_rate'].mean():.3f}",
                    delta="Average"
                )

        st.markdown("#### Detailed Accountability Table")
        st.dataframe(
            accountability_df.style.format({
                'approval_pct': '{:.2f}%',
                'readmission_rate': '{:.4f}',
                'mortality_rate': '{:.4f}'
            }),
            use_container_width=True,
            hide_index=True
        )
except Exception as e:
    st.warning(f"Could not load accountability data: {str(e)[:50]}")


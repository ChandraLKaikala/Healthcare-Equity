    <div style='background: #06D6A015; border-left: 4px solid #06D6A0; padding: 15px; border-radius: 8px; text-align: center; color: #06D6A0; font-weight: 600;'>
        Auto-refreshing every 5 seconds...
    </div>
    """, unsafe_allow_html=True)
    time.sleep(5)
    st.rerun()

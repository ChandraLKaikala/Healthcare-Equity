# CONNECTION SETUP
@st.cache_resource
def get_databricks_connection():
    from dotenv import load_dotenv
    load_dotenv('.env.databricks')
    from databricks.sql import connect

    host = os.getenv('DATABRICKS_HOST').replace('https://', '')
    token = os.getenv('DATABRICKS_TOKEN')
    http_path = os.getenv('DATABRICKS_HTTP_PATH')

    return connect(
        server_hostname=host,
        http_path=http_path,
        personal_access_token=token
    )

# DATA LOADING WITH DATE FILTERING
def load_scenario_data_with_dates(scenario, start_date, end_date):
    """Load data with DATE-BASED FILTERING"""
    try:
        conn = get_databricks_connection()
        cursor = conn.cursor()

        # CRITICAL FIX: Filter by date ranges that actually affect the data
        query = f"""
        SELECT
            scenario_type,
            race,
            gender,
            approval_rate,
            ROUND(approval_rate / MAX(approval_rate) OVER () * 100, 2) as dir_percentage,
            total_decisions,
            unique_patients,
            first_decision_date,
            last_decision_date
        FROM healthcare_equity_gold.bias_metrics
        WHERE scenario_type = '{scenario}'
        AND first_decision_date >= '{start_date}'
        AND last_decision_date <= '{end_date}'
        """

        cursor.execute(query)
        results = cursor.fetchall()

        if results:
            cols = [desc[0] for desc in cursor.description]
            return pd.DataFrame(results, columns=cols)
        return pd.DataFrame()

    except Exception as e:
        st.error(f"Error loading data: {str(e)[:100]}")
        return pd.DataFrame()

def load_dashboard_summary(start_date, end_date):
    """Load summary with date filtering"""
    try:
        conn = get_databricks_connection()
        cursor = conn.cursor()

        query = f"""
        SELECT
            COUNT(DISTINCT p.patient_id) as total_patients,
            COUNT(DISTINCT d.decision_id) as total_decisions,
            ROUND(AVG(p.sofa_score), 2) as avg_clinical_severity,
            ROUND(SUM(CASE WHEN p.gender = 'F' THEN 1 ELSE 0 END) / COUNT(*) * 100, 2) as pct_female,
            ROUND(SUM(CASE WHEN p.race = 'Black' THEN 1 ELSE 0 END) / COUNT(*) * 100, 2) as pct_black,
            ROUND(SUM(d.decision_flag) / COUNT(d.decision_id) * 100, 2) as overall_approval_rate,
            COUNT(DISTINCT d.scenario_type) as scenarios_analyzed
        FROM healthcare_equity_silver.patients_processed p
        LEFT JOIN healthcare_equity_silver.decisions_processed d ON p.patient_id = d.patient_id
        WHERE d.decision_date >= '{start_date}' AND d.decision_date <= '{end_date}'
        """

        cursor.execute(query)
        result = cursor.fetchone()

        if result:
            cols = [desc[0] for desc in cursor.description]
            return dict(zip(cols, result))
        return {}

    except Exception as e:
        st.error(f"Error: {str(e)[:80]}")
        return {}

